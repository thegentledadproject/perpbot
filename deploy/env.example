# Non-secret runtime settings for polyperps. Installed to
# /etc/polyperps/env by deploy/bootstrap.sh (only if that file does not
# already exist - it will not overwrite your edits on a later deploy).
#
# Secrets (Telegram bot token / chat id) do NOT go here - see
# polyperps/security/key_management.py. Use systemd LoadCredential= with
# files under /etc/credstore/ instead.
#
# POLYMARKET_LIVE_TRADING must NEVER be set in this file. Phase 2a only
# ever runs --executor sim; live trading is a separate, deliberate change
# gated by polyperps/gates.py, not something this deploy touches.

# Comma-separated instrument ids to feed and trade.
POLYPERPS_INSTRUMENT_IDS=6,7

# SQLite path shared by run_feed.py and run_paper.py.
POLYPERPS_DB_PATH=/var/lib/polyperps/polyperps.sqlite3

# Strategy hypothesis and run id for polyperps-paper.service. --run-id
# names the paper account; keep it stable across restarts so recovery
# reopens the same book instead of minting a fresh one.
PAPER_HYPOTHESIS=h1
PAPER_RUN_ID=paper-soak-1

# Dashboard bind address. The box serves on all interfaces, port 80; restrict
# reach with the EC2 security group (the page has no auth and no TLS).
POLYPERPS_DASHBOARD_BIND=0.0.0.0:80

# Tick retention, in days, for the daily polyperps-prune.timer. Ticks cost
# ~370 MB/day; unbounded retention filled the 6.7 GB disk in 10 days.
RETAIN_DAYS=3
